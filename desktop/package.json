{
  "name": "black-cord-desktop",
  "version": "1.0.0",
  "private": true,
  "description": "Black Cord Windows desktop client.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.blackcord.desktop",
    "productName": "Black Cord",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "app-config.json",
      "assets/**/*"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Black-Cord-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Black Cord"
    }
  }
}
